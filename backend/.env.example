NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://hope:hope@localhost:5432/hope
PG_POOL_MAX=10
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=900
ACCESS_TOKEN_ISSUER=hope-api
ACCESS_TOKEN_AUDIENCE=hope-mobile
REFRESH_TOKEN_TTL=2592000
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
STORAGE_DIR=storage
DATA_FILE=data/hope.json
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
TRUST_PROXY=false
PUBLIC_BASE_URL=https://api.example.com
STORAGE_BACKEND=s3
S3_BUCKET=hope
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=uploads
UPLOAD_INTENT_TTL_SECONDS=300
ALLOWED_CORS_ORIGINS=http://localhost:3000
METRICS_TOKEN=replace-with-a-long-random-metrics-token
GENERAL_RATE_LIMIT_WINDOW_MS=60000
GENERAL_RATE_LIMIT_MAX=120
RESET_TOKEN_TTL=900
EXPOSE_RESET_TOKEN_IN_DEVELOPMENT=false
RESET_TOKEN_DELIVERY_MODE=console
RESET_TOKEN_DELIVERY_URL=
RESET_TOKEN_DELIVERY_TIMEOUT_MS=5000
PAYMENT_PROVIDER=simulator
PAYMENT_CURRENCY=USD
MAX_IDEMPOTENCY_KEY_LENGTH=200
